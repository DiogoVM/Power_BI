
Medida Card HTML = 

VAR Larg = 160
VAR Alt = 50
VAR Barra = 10
VAR Valor = [Valor]
VAR Percentual = [Valor %]
VAR ValorFmt = FORMAT(Valor, "R$ #,##0.00")
VAR PctFmt = FORMAT(Percentual, "0.0%")
RETURN
"
<style>

    .card
    {
        position:relative;
        width:100vw;
        height:50vw;
        background:transparent;

        display:flex;
        justify-content:center;
        align-items:center;
        border-radius:4px;

        overflow:hidden;
    }
    .barra
    {
        position:absolute;
        left:0;
        top:0;        
        width:5%;
        height:100%;
        background:#002364;
    }
    .titulo1
    {
        position:absolute;
        left:1%;
        top:1%;        
        width:100%;
        height:25%;

        display:flex;
        justify-content:center;
        align-items:center;
        font-family:Segoe UI, Arial, sans-serif;

        margin-top:1%;
        font-size:14px;
        font-weight:500;
        color:#002364;

    }
    .vlr1
    {
        position:absolute;
        left:1%;
        top:1%;         
        width:100%;
        height:25%;

        display:flex;
        justify-content:center;
        align-items:center;
        font-family:Segoe UI, Arial, sans-serif;

        margin-top:15%;
        font-size:22px;
        font-weight:650;
        color:#002364;
    }
    .titulo2
    {
        position:absolute;
        left:1%;
        top:1%;         
        width:100%;
        height:25%;

        display:flex;
        justify-content:center;
        align-items:center;
        font-family:Segoe UI, Arial, sans-serif;

        margin-top:35%;
        font-size:14px;
        font-weight:500;
        color:#002364;

    }
    .vlr2
    {
        position:absolute;
        right:5%;
        top:1%;        
        width:100%;
        height:25%;

        display:flex;
        justify-content:right;
        align-items:center;
        font-family:Segoe UI, Arial, sans-serif;

        margin-top:35%;
        font-size:14px;
        font-weight:650;
        color:#002364;
    }
</style>

<div class='card'>
    <div class='barra'>

    </div>
        <div class='titulo1'>Valor alcançado</div>
        <div class='vlr1'>"& ValorFmt &"</div>

        <div class='titulo2'>Valor %: </div>
        <div class='vlr2'>"& PctFmt &"</div>

</div>

"
